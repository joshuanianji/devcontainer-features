{
    "name": "Token Monitor Agent",
    "id": "token-monitor-agent",
    "version": "1.0.0",
    "documentationURL": "https://github.com/joshuanianji/devcontainer-features/tree/main/src/token-monitor-agent",
    "description": "Report token usage from this container's /dc volumes to a self-hosted Javis603/token-monitor hub.",
    "options": {},
    "mounts": [
        {
            "source": "${devcontainerId}-token-monitor",
            "target": "/dc/token-monitor/state",
            "type": "volume"
        },
        {
            "source": "${localEnv:HOME}/.config/token-mon/env",
            "target": "/dc/token-monitor/config/env",
            "type": "bind"
        }
    ],
    "onCreateCommand": {
        "token-monitor-agent-setup": "/usr/local/share/token-monitor-agent/scripts/oncreate.sh"
    },
    "postStartCommand": {
        "token-monitor-agent-start": "/usr/local/share/token-monitor-agent/scripts/start.sh"
    }
}
